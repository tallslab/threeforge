{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "threeforge": ["./src/index.ts"],
      "threeforge/overlay": ["./src/overlay/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src", "test", "*.ts"]
}
