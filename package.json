{
  "name": "threeforge",
  "version": "0.1.0",
  "description": "Scene compiler + draw-call diagnostics for three.js. Batches naive scenes at load time and explains every remaining draw call.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "playwright test test/e2e/budget.spec.ts --project=webgl2",
    "spike": "playwright test test/e2e/spike-scene-optimizer.spec.ts --project=webgl2",
    "dev": "vite --config vite.config.ts"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "0.186.0",
    "three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "bvh.js": "0.0.13",
    "meshoptimizer": "1.2.0"
  }
}
