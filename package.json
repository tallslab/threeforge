{
  "name": "threeforge",
  "version": "0.2.0",
  "description": "Frame-budget compiler and diagnostics for three.js games: batches naive scenes, measures every frame cost, explains what to fix. CLI and MCP for AI agents.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "AGENTS.md",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    },
    "./cli": {
      "types": "./dist/cli/api.d.ts",
      "import": "./dist/cli/api.js"
    }
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:cli-app",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "playwright test test/e2e/budget.spec.ts --project=webgl2",
    "spike": "playwright test test/e2e/spike-scene-optimizer.spec.ts --project=webgl2",
    "dev": "vite --config vite.config.ts",
    "assets": "node scripts/fetch-assets.mjs",
    "assets:report": "playwright test test/e2e/assets.spec.ts --project=webgl2",
    "bench": "node scripts/bench-run.mjs",
    "bench:baseline": "node scripts/bench-baseline.mjs",
    "bench:table": "node scripts/bench-table.mjs",
    "assets:kits": "node scripts/fetch-kits.mjs",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:cli-app": "node scripts/copy-decoders.mjs && vite build --config vite.cli.config.ts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0",
    "playwright": ">=1.50.0",
    "three": ">=0.180.0",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "bvh.js": "0.0.13",
    "meshoptimizer": "1.2.0",
    "pngjs": "^7.0.0",
    "three-mesh-bvh": "0.9.15"
  },
  "bin": {
    "threeforge": "dist/cli/index.js"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "webgl",
    "batching",
    "instancing",
    "draw-calls",
    "performance",
    "game",
    "mobile",
    "ai-agents",
    "mcp"
  ]
}
